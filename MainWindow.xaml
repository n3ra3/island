<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        Width="760" Height="500"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource Font}" FontSize="13" Foreground="{StaticResource Label}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Typography.NumeralAlignment="Tabular" AllowDrop="True">

    <!-- Окно рисуется видеокартой, а его «форма» повторяет островок — клики мимо уходят в окна под ним -->
    <Grid x:Name="Root">

        <!-- Островок прикреплён к верхнему краю: прямой верх с плавными «ушками», скругление только снизу -->
        <Border x:Name="Island" Background="Transparent" Width="252" Height="36"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0" AllowDrop="True">
            <Grid>
                <Path x:Name="Shape" Fill="Black"/>
                <Grid Margin="10,0">

                <!-- Компакт -->
                <!-- Прозрачный фон фиксирует рамку слоя: движение глазков не сдвигает остальное содержимое -->
                <Grid x:Name="Compact" Height="36" VerticalAlignment="Top" Margin="8,0,11,0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Глазки: две капсулы у левого края -->
                    <Canvas x:Name="Eyes" Width="17" Height="14" Margin="3,0,8,0" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Blink"/>
                                <TranslateTransform x:Name="EyesBob"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Border Width="5" Height="10" CornerRadius="2.5" Background="#F2F2F7" Canvas.Left="1" Canvas.Top="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="LidL"/>
                                    <TranslateTransform x:Name="PupilL"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="5" Height="10" CornerRadius="2.5" Background="#F2F2F7" Canvas.Left="11" Canvas.Top="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="LidR"/>
                                    <TranslateTransform x:Name="PupilR"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <!-- Головокружение: орбита над глазками, по ней бегают две звёздочки -->
                        <Canvas x:Name="Dizzy" Canvas.Left="-1" Canvas.Top="-10" Width="19" Height="8" Opacity="0">
                            <Ellipse Width="19" Height="6" Canvas.Top="1" Stroke="{StaticResource Label3}" StrokeThickness="1"/>
                            <Path x:Name="Star1" Data="M0,-2.2 L0.6,-0.6 L2.2,0 L0.6,0.6 L0,2.2 L-0.6,0.6 L-2.2,0 L-0.6,-0.6 Z" Fill="#FFD60A">
                                <Path.RenderTransform><TranslateTransform x:Name="Star1T"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Star2" Data="M0,-1.8 L0.5,-0.5 L1.8,0 L0.5,0.5 L0,1.8 L-0.5,0.5 L-1.8,0 L-0.5,-0.5 Z" Fill="#F2F2F7">
                                <Path.RenderTransform><TranslateTransform x:Name="Star2T"/></Path.RenderTransform>
                            </Path>
                        </Canvas>
                        <!-- «z z z», когда спит -->
                        <TextBlock x:Name="Zzz1" Text="z" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Label2}" Canvas.Left="17" Canvas.Top="-1" Opacity="0">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="Zzz1T"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="Zzz2" Text="z" FontSize="6" FontWeight="Bold" Foreground="{StaticResource Label2}" Canvas.Left="19" Canvas.Top="-3" Opacity="0">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="Zzz2T"/></TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <StackPanel x:Name="CompactMedia" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="{StaticResource ArtPlaceholder}"/>
                        <StackPanel x:Name="Wave" Orientation="Horizontal" Margin="7,0,0,0" Height="14" VerticalAlignment="Center">
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Orange}" Margin="0,0,2,0"/>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Orange}" Margin="0,0,2,0"/>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Orange}" Margin="0,0,2,0"/>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Orange}"/>
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactClock" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <local:WeatherIcon x:Name="CompactWx" Width="17" Height="17" FrameRate="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactTemp" Foreground="{StaticResource Label2}" FontWeight="Medium"/>
                    </StackPanel>
                </Grid>

                <!-- Наведение: мини-плеер -->
                <Grid x:Name="Peek" Width="372" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Hidden" Background="Transparent">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PeekArt" Width="52" Height="52" CornerRadius="12" Background="{StaticResource ArtPlaceholder}"/>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekTitle" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="PeekArtist" Style="{StaticResource Sub}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="PeekControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Transport}" Click="Prev_Click" ToolTip="Предыдущий">
                                <local:Icon Data="{StaticResource f.prev}" Filled="True" Width="22" Height="22"/>
                            </Button>
                            <Button Style="{StaticResource Transport}" Click="Play_Click" ToolTip="Пауза / воспроизведение">
                                <local:Icon x:Name="PeekPlay" Data="{StaticResource f.pause}" Filled="True" Width="28" Height="28"/>
                            </Button>
                            <Button Style="{StaticResource Transport}" Click="Next_Click" ToolTip="Следующий">
                                <local:Icon Data="{StaticResource f.next}" Filled="True" Width="22" Height="22"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Короткая всплывашка: громкость, раскладка, Caps Lock -->
                <Grid x:Name="Osd" Height="36" VerticalAlignment="Top" Opacity="0" Visibility="Hidden" Margin="12,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:Icon x:Name="OsdIcon" Data="{StaticResource i.volume}" Width="17" Height="17" VerticalAlignment="Center"/>
                    <Grid x:Name="OsdBar" Grid.Column="1" Height="5" Margin="10,0" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="{StaticResource Fill3}"/>
                        <!-- Заполнение = доля от самой дорожки: 100% всегда ровно до края -->
                        <Border x:Name="OsdFill" CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="OsdFillScale" ScaleX="0"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <!-- Текстовая всплывашка (раскладка, Caps Lock): значок и надпись ровно по центру -->
                    <StackPanel x:Name="OsdCenter" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon x:Name="OsdCenterIcon" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="OsdText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Постоянная ширина: «100» и «9» занимают одно место, полоска не прыгает -->
                    <TextBlock x:Name="OsdValue" Grid.Column="2" Width="26" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Label2}"/>
                </Grid>

                <!-- Уведомление -->
                <Grid x:Name="Notif" Width="400" Height="76" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Hidden" Background="Transparent">
                    <Grid Margin="14,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="NotifIcon" Width="44" Height="44" CornerRadius="11" Background="{StaticResource Fill2}">
                            <local:Icon x:Name="NotifBell" Data="{StaticResource i.bell}" Width="22" Height="22"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="NotifApp" FontSize="12" Foreground="{StaticResource Label2}" TextTrimming="CharacterEllipsis" Margin="0,0,50,0"/>
                                <TextBlock Text="сейчас" FontSize="12" Foreground="{StaticResource Label3}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="NotifTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            <TextBlock x:Name="NotifBody" FontSize="13" Foreground="{StaticResource Label2}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Панель -->
                <Grid x:Name="Full" Width="720" Height="404" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Hidden">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="False">
                            <Border Background="{StaticResource Fill1}" CornerRadius="10" Padding="2" DockPanel.Dock="Left">
                                <Grid>
                                    <Border x:Name="TabHl" Background="{StaticResource Fill3}" CornerRadius="8"
                                            HorizontalAlignment="Left" Width="0">
                                        <Border.RenderTransform><TranslateTransform x:Name="TabHlT"/></Border.RenderTransform>
                                    </Border>
                                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal">
                                        <Button Tag="home" Click="Tab_Click" Style="{StaticResource Btn}" local:Ui.Hover="0" Height="28" Padding="11,0" Foreground="{StaticResource Label2}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource i.home}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Главная" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="clip" Click="Tab_Click" Style="{StaticResource Btn}" local:Ui.Hover="0" Height="28" Padding="11,0" Foreground="{StaticResource Label2}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource i.clip}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Буфер" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="note" Click="Tab_Click" Style="{StaticResource Btn}" local:Ui.Hover="0" Height="28" Padding="11,0" Foreground="{StaticResource Label2}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource i.note}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Заметки" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="shelf" Click="Tab_Click" Style="{StaticResource Btn}" local:Ui.Hover="0" Height="28" Padding="11,0" Foreground="{StaticResource Label2}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource i.tray}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Полка" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="wth" Click="Tab_Click" Style="{StaticResource Btn}" local:Ui.Hover="0" Height="28" Padding="11,0" Foreground="{StaticResource Label2}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource i.cloud}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Погода" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="ctl" Click="Tab_Click" Style="{StaticResource Btn}" local:Ui.Hover="0" Height="28" Padding="11,0" Foreground="{StaticResource Label2}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource i.sliders}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Система" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource Round}" Click="Close_Click" ToolTip="Свернуть" Margin="8,0,0,0">
                                <local:Icon Data="{StaticResource i.x}" Width="14" Height="14" Thickness="2.2"/>
                            </Button>
                            <Button x:Name="SettingsBtn" DockPanel.Dock="Right" Style="{StaticResource Round}" Click="Settings_Click" ToolTip="Настройки" Margin="8,0,0,0">
                                <local:Icon Data="{StaticResource i.gear}" Width="15" Height="15" Thickness="2"/>
                            </Button>
                            <Button x:Name="PinBtn" DockPanel.Dock="Right" Style="{StaticResource Round}" Click="Pin_Click" ToolTip="Не сворачивать при клике мимо">
                                <local:Icon Data="{StaticResource i.pin}" Width="14" Height="14" Thickness="2"/>
                            </Button>
                        </DockPanel>

                        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,12,0,0" Focusable="False"/>
                    </Grid>
                </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Подтверждение действия -->
        <Border x:Name="Hud" Background="{StaticResource Fill1}" CornerRadius="16" Padding="12,8,14,8"
                HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="HudT"/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <local:Icon x:Name="HudIcon" Data="{StaticResource i.check}" Width="16" Height="16" Thickness="2.4" Foreground="{StaticResource Green}" Margin="0,0,8,0"/>
                <TextBlock x:Name="HudText" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
