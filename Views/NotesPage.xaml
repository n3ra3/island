<UserControl x:Class="DynamicIsland.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="264"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Заметки ===== -->
        <Border Style="{StaticResource Card}" Padding="12,10,12,8" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="NoteTabs" Orientation="Horizontal"/>
                    <Button Style="{StaticResource Tool}" Click="AddNote_Click" ToolTip="Новая заметка" Height="26" MinWidth="26" Padding="0">
                        <local:Icon Data="{StaticResource i.plus}" Width="14" Height="14" Thickness="2"/>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" Margin="2,10,2,6">
                    <TextBlock x:Name="Placeholder" Text="Пиши сюда что угодно: номер заказа, список дел, кусок кода. Сохраняется само."
                               Foreground="{StaticResource Label3}" FontSize="14" TextWrapping="Wrap" IsHitTestVisible="False"/>
                    <RichTextBox x:Name="Editor" Style="{StaticResource PlainRich}" AcceptsTab="True">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph"><Setter Property="Margin" Value="0,0,0,4"/></Style>
                            <Style TargetType="List"><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="18,0,0,0"/></Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Grid>

                <DockPanel Grid.Row="2" LastChildFill="False">
                    <Button Style="{StaticResource Tool}" Click="Bold_Click" ToolTip="Жирный (Ctrl+B)">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="Italic_Click" ToolTip="Курсив (Ctrl+I)">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="14" FontFamily="Georgia"/>
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="Strike_Click" ToolTip="Зачеркнуть">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14"/>
                    </Button>
                    <Border Width="1" Height="16" Background="{StaticResource Sep}" Margin="6,0"/>
                    <Button Style="{StaticResource Tool}" Click="Bullets_Click" ToolTip="Список">
                        <local:Icon Data="{StaticResource i.bullets}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="Numbers_Click" ToolTip="Нумерованный список">
                        <local:Icon Data="{StaticResource i.numbers}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="Check_Click" ToolTip="Чек-лист: нажми на квадратик, чтобы отметить">
                        <local:Icon Data="{StaticResource i.checklist}" Width="16" Height="16"/>
                    </Button>
                    <Border Width="1" Height="16" Background="{StaticResource Sep}" Margin="6,0"/>
                    <Button Style="{StaticResource Tool}" Click="Remind_Click" ToolTip="Сделать из строки напоминание">
                        <StackPanel Orientation="Horizontal">
                            <local:Icon Data="{StaticResource i.alarm}" Width="15" Height="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Напомнить" FontWeight="Medium" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteBtn" DockPanel.Dock="Right" Style="{StaticResource Tool}" Click="Delete_Click" ToolTip="Удалить заметку">
                        <local:Icon Data="{StaticResource i.trash}" Width="16" Height="16"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Click="Copy_Click" ToolTip="Скопировать текст">
                        <local:Icon Data="{StaticResource i.copy}" Width="16" Height="16"/>
                    </Button>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== Таймер и напоминания ===== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Ring" Width="76" Height="76">
                        <Ellipse Stroke="{StaticResource Fill3}" StrokeThickness="4"/>
                        <Path x:Name="Arc" Stroke="{StaticResource Orange}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="TimeText" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="StartBtn" Style="{StaticResource Btn}" Click="Start_Click" Height="34" local:Ui.Radius="10"
                                Background="{StaticResource Orange}" Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon x:Name="StartIcon" Data="{StaticResource f.play}" Filled="True" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StartText" Text="Старт" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,6,0,0" Height="30">
                            <Button x:Name="SecondBtn" Style="{StaticResource Btn}" Click="Second_Click" local:Ui.Radius="9"
                                    Background="{StaticResource Fill2}" Foreground="{StaticResource Label2}">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon x:Name="SecondIcon" Data="{StaticResource i.note}" Width="13" Height="13" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="SecondText" Text="Своё время" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="TimeEditBox" Background="{StaticResource Fill3}" CornerRadius="9" Visibility="Collapsed">
                                <TextBox x:Name="TimeEdit" Style="{StaticResource Plain}" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"
                                         ToolTip="7 — минуты, 7:30 — минуты и секунды, 1:20:00 — часы. Enter — готово"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="Presets" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,0,6">
                    <local:Icon Data="{StaticResource i.bell}" Width="14" Height="14" Foreground="{StaticResource Label2}" Margin="0,0,6,0"/>
                    <TextBlock Text="Напоминания" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Label2}"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="RemList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="RemEmpty" FontSize="11" Foreground="{StaticResource Label3}" TextAlignment="Center"
                               TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="16"
                               Text="Напиши ниже, о чём и когда:&#10;«позвонить маме завтра в 9»,&#10;«таблетки каждый день в 23:00»,&#10;«через 20 минут выключить плиту»"/>
                </Grid>

                <Border Grid.Row="4" Background="{StaticResource Fill2}" CornerRadius="10" Height="34" Padding="10,0" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock x:Name="RemPlaceholder" Text="Позвонить маме завтра в 9" Foreground="{StaticResource Label3}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="RemInput" Style="{StaticResource Plain}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
