<UserControl x:Class="DynamicIsland.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="292"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Плеер + текст песни -->
        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <Border x:Name="Art" Width="76" Height="76" CornerRadius="14" Background="{StaticResource ArtPlaceholder}" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <Ellipse x:Name="SrcDot" Width="6" Height="6" Fill="{StaticResource Red}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SrcText" FontSize="11" Foreground="{StaticResource Label2}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="ArtistText" Style="{StaticResource Sub}"/>

                    <Grid x:Name="Scrub" Height="16" Margin="0,8,0,0" Background="Transparent" Cursor="Hand">
                        <Border x:Name="ScrubTrack" Height="4" CornerRadius="2" Background="{StaticResource Fill2}" VerticalAlignment="Center"/>
                        <Border x:Name="ScrubFill" Height="4" CornerRadius="2" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                    </Grid>
                    <Grid x:Name="Times">
                        <TextBlock x:Name="CurText" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Label2}"/>
                        <TextBlock x:Name="RemText" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Label2}" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel x:Name="Transport" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Style="{StaticResource Transport}" Click="Prev_Click" Margin="0,0,8,0" ToolTip="Предыдущий">
                            <local:Icon Data="{StaticResource f.prev}" Filled="True" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource Transport}" Click="Play_Click" Width="42" Height="42" local:Ui.Radius="21" Background="{StaticResource Fill2}">
                            <local:Icon x:Name="PlayIcon" Data="{StaticResource f.pause}" Filled="True" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource Transport}" Click="Next_Click" Margin="8,0,0,0" ToolTip="Следующий">
                            <local:Icon Data="{StaticResource f.next}" Filled="True" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Текст песни: прошлая, текущая и следующая строки -->
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Border Width="1" HorizontalAlignment="Left" Background="{StaticResource Sep}" Margin="-8,6,0,6"/>
                    <!-- Весь текст столбиком, как в Spotify: плавно прокручивается, края растворяются -->
                    <Grid x:Name="Lyrics" ClipToBounds="True" Margin="6,0,0,12" Background="Transparent">
                        <Grid.OpacityMask>
                            <LinearGradientBrush x:Name="LyMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,200">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.16"/>
                                <GradientStop Color="Black" Offset="0.78"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <!-- Canvas не обрезает ленту — иначе после прокрутки на месте строк была пустота -->
                        <Canvas x:Name="LyCanvas">
                            <StackPanel x:Name="LyLines">
                                <StackPanel.RenderTransform><TranslateTransform x:Name="LyScroll"/></StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Grid>
                    <StackPanel x:Name="LyEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <local:Icon Data="{StaticResource i.music}" Width="26" Height="26" Foreground="{StaticResource Label3}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LyEmptyText" Foreground="{StaticResource Label3}" Margin="0,8,0,0" TextAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="LySource" Text="Текст: lrclib.net" FontSize="10" Foreground="{StaticResource Label3}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Громкость: тянуть мышью или крутить колесо -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="Vol" Height="28" Cursor="Hand" Background="Transparent" ToolTip="Тяни или крути колесо">
                    <Border CornerRadius="14" Background="{StaticResource Fill2}"/>
                    <Border x:Name="VolFill" CornerRadius="14" Background="White" HorizontalAlignment="Left" Width="28"/>
                    <local:Icon x:Name="VolIcon" Data="{StaticResource i.volume}" Width="16" Height="16" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="Black"/>
                </Grid>
                <TextBlock x:Name="VolText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="Medium" Foreground="{StaticResource Label2}"/>
            </Grid>
        </Border>

        <!-- Быстрые действия -->
        <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="8,14,8,8">
            <StackPanel>
                <TextBlock Text="Быстрые действия" FontWeight="SemiBold" Margin="8,0,0,14"/>
                <UniformGrid x:Name="Cmds" Columns="4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
