<UserControl x:Class="DynamicIsland.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16,4">
                <StackPanel x:Name="Rows"/>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Город для погоды" FontSize="14" FontWeight="Medium"/>
                        <TextBlock x:Name="CityNow" FontSize="12" Foreground="{StaticResource Label2}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Fill2}" CornerRadius="10" Padding="10,0" Height="34">
                        <TextBox x:Name="CityBox" Style="{StaticResource Plain}" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource Btn}" Click="City_Click" Margin="8,0,0,0" Padding="14,0" Height="34"
                            Background="{StaticResource Blue}" local:Ui.Radius="10">
                        <TextBlock Text="Сохранить" FontWeight="Medium"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Обновления -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="14" FontWeight="Medium"/>
                        <TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="{StaticResource Label2}"/>
                    </StackPanel>
                    <Button x:Name="UpdateBtn" Grid.Column="1" Style="{StaticResource Btn}" Click="Update_Click" Padding="14,0" Height="34"
                            Background="{StaticResource Fill2}" local:Ui.Radius="10">
                        <TextBlock x:Name="UpdateBtnText" Text="Проверить обновления" FontWeight="Medium"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="4,12,4,0">
                <TextBlock Text="Открыть панель: Win + `  ·  Свернуть: Esc" Foreground="{StaticResource Label3}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Btn}" Click="Quit_Click" HorizontalAlignment="Right" Padding="12,6"
                        local:Ui.Radius="10" Foreground="{StaticResource Red}">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource i.exit}" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Выйти из приложения" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
