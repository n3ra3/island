<UserControl x:Class="DynamicIsland.WeatherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland">
    <Grid>
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="20" Padding="16" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3B78D8" Offset="0"/>
                        <GradientStop Color="#2556A8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <TextBlock x:Name="City" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid DockPanel.Dock="Top" Margin="-3,6,0,0">
                        <TextBlock x:Name="Big" FontSize="64" FontWeight="ExtraLight"/>
                        <local:WeatherIcon x:Name="BigIcon" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="Desc" DockPanel.Dock="Top" FontSize="13" Opacity="0.9"/>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <TextBlock x:Name="HiLo" FontWeight="Medium"/>
                        <TextBlock x:Name="Extra" FontSize="12" Opacity="0.75" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <UniformGrid x:Name="Hours" Rows="1"/>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,4">
                    <StackPanel x:Name="Days" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>

        <StackPanel x:Name="State" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="StateText" Foreground="{StaticResource Label2}" FontWeight="Medium" TextAlignment="Center"/>
            <Button x:Name="Retry" Style="{StaticResource Btn}" Click="Retry_Click" Margin="0,12,0,0" Padding="16,8"
                    Background="{StaticResource Fill2}" local:Ui.Radius="10" HorizontalAlignment="Center">
                <TextBlock Text="Повторить" FontWeight="Medium"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
