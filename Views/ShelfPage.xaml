<UserControl x:Class="DynamicIsland.ShelfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="4,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Полка" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Временное место для файлов: положи сюда, потом перетащи куда нужно" FontSize="12" Foreground="{StaticResource Label2}"/>
            </StackPanel>
            <Button x:Name="ClearBtn" Style="{StaticResource Btn}" Click="Clear_Click" HorizontalAlignment="Right" Padding="12,6"
                    Background="{StaticResource Fill1}" local:Ui.Radius="10" Foreground="{StaticResource Label2}">
                <TextBlock Text="Очистить" FontWeight="Medium"/>
            </Button>
        </Grid>

        <Grid x:Name="Drop" Grid.Row="1" AllowDrop="True" Background="Transparent">
            <Rectangle x:Name="Frame" RadiusX="20" RadiusY="20" Stroke="{StaticResource Fill3}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Data="{StaticResource i.tray}" Width="34" Height="34" Foreground="{StaticResource Label3}" HorizontalAlignment="Center"/>
                <TextBlock Text="Перетащи сюда файлы, папки или ярлыки" FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource Label2}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                <TextBlock Text="Можно бросить прямо на островок — он откроет полку сам" FontSize="12"
                           Foreground="{StaticResource Label3}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="12">
                <WrapPanel x:Name="Items"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
